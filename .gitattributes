# Normalise line endings so the repo works on every OS.
* text=auto eol=lf

# Shell scripts and Python must stay LF, even when cloned on Windows.
yt            text eol=lf
install.sh    text eol=lf
yt.py         text eol=lf
*.py          text eol=lf

# Windows-only scripts are happiest with CRLF.
*.ps1         text eol=crlf
*.cmd         text eol=crlf
*.bat         text eol=crlf

*.mp3 -text
*.m4a -text
*.mp4 -text
